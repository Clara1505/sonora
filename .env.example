# ============================================================
# Sonora — Variables d'environnement requises
# Copier ce fichier en .env et renseigner les valeurs réelles.
# Ne jamais commiter le fichier .env dans le dépôt git.
# ============================================================

# ── Base de données ──────────────────────────────────────────────
DB_URL=jdbc:postgresql://sonora-db:5432/sonora
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

# ── JWT ──────────────────────────────────────────────────────────
# Minimum 256 bits (32 caractères). Générer avec :
#   openssl rand -base64 32
JWT_SECRET=CHANGE_ME
JWT_EXPIRATION_MS=86400000

# ── Kafka ────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka-0:9092,kafka-1:9092,kafka-2:9092

# ── Spotify (optionnel) ──────────────────────────────────────────
SPOTIFY_CLIENT_ID=CHANGE_ME
SPOTIFY_CLIENT_SECRET=CHANGE_ME

# ── Spring ───────────────────────────────────────────────────────
# 'dev' active le profil local (swagger, ddl-auto=update)
# Laisser vide ou mettre 'prod' en production
SPRING_PROFILES_ACTIVE=dev

# ── Swagger ──────────────────────────────────────────────────────
# Forcé à false en prod, true en dev via application-dev.properties
SWAGGER_ENABLED=false